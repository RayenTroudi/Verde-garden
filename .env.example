# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/verde-garden?retryWrites=true&w=majority

# Cloudinary Configuration (server-side)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudinary (public - accessible in browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# App URL (used for QR code links — set to production domain in prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-32-char-secret-here
NEXT_AUTH_ADMIN_USERNAME=admin
NEXT_AUTH_ADMIN_PASSWORD=your-bcrypt-hashed-password-here
